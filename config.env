CONFIG_ENV=config.env

# 1. Kernel Details
KERNEL_SOURCE=https://github.com/RiteshSahany/kernel_xiaomi_sm6250
KERNEL_SOURCE_BRANCH=16
KERNEL_CONFIG=vendor/xiaomi/miatoll_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true

# 2. Compiler Settings (Ritesh trees compile perfectly with standard Clang)
USE_CUSTOM_CLANG=false
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# 3. KernelSU Configuration Switches
ENABLE_KERNELSU=true
KERNELSU_TAG=main
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true

# 4. KSU Patch Hook
APPLY_KSU_PATCH=true
